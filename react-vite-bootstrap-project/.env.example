# В деве не нужен — запросы к Catalog API идут через прокси в vite.config.ts
# (обходит отсутствующий CORS на бэке, см. бриф, раздел 10).
#
# Для прод-сборки (Vercel и т.п.) задать явно, когда согласуют домен/CORS с Романом:
# VITE_API_BASE=https://api.greenmarket.example/api/v1/catalog

# Public Store Identity for QR/share/public-domain entry.
# Prefer API fields public_slug/public_url. Use this only until backend owns the mapping.
# VITE_PUBLIC_STORE_IDENTITIES={"6":{"public_slug":"dev-marker","public_url":"https://dev-marker.example/"}}
# Or build public URLs from stable API public_slug:
# VITE_PUBLIC_STORE_DOMAIN=stores.example
# VITE_PUBLIC_STORE_URL_PATTERN=https://{slug}.stores.example/
